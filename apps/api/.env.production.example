# ---------------------------------------------------------------------------
# District One Realty API — PRODUCTION environment template (Hostinger).
# Copy this to `.env` in the Node.js app's directory via hPanel's Node.js app file manager
# (or SSH), then fill in every placeholder below. Never commit the real `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=5000

# MySQL — from hPanel: Databases > MySQL Databases. Hostinger's shared MySQL only accepts
# connections from localhost, which is what you want here since the API runs on the same
# server. The username/database name Hostinger generates are usually prefixed with your
# hosting account username (e.g. u123456789_d1realty) — copy them exactly as shown in hPanel.
DATABASE_URL="mysql://<db_user>:<db_password>@localhost:3306/<db_name>"

# JWT / Auth — generate a real random secret, e.g. `openssl rand -base64 48`. Do NOT reuse the
# placeholder from .env.example or any secret used in development/testing.
JWT_ACCESS_SECRET=<generate-a-new-random-secret-at-least-32-characters>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Lets the admin/refresh cookies be valid across all districtonerealty.com subdomains (the
# public site, admin panel, and API all share this parent domain).
COOKIE_DOMAIN=.districtonerealty.com

# Frontend origins allowed by CORS — must match exactly (scheme + host, no trailing slash).
PUBLIC_WEB_URL=https://www.districtonerealty.com
ADMIN_WEB_URL=https://admin.districtonerealty.com

# These only apply when NODE_ENV=development — DO NOT add them here even blank. They're validated
# as URLs (z.string().url().optional()), and dotenv loads `KEY=` as an empty string rather than
# undefined, which fails that validation and crashes the app on boot. Omit the lines entirely.

# Cloudinary is recommended for production (CDN delivery + image transforms instead of serving
# every property photo straight off shared hosting bandwidth) but not required — leave all three
# blank to keep using local disk storage instead (see UPLOADS_DIR below).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required if CLOUDINARY_* above are left blank (local storage fallback) — must be the real
# public API URL so uploaded file links resolve correctly for site visitors.
API_PUBLIC_URL=https://api.districtonerealty.com

# Required if CLOUDINARY_* above are left blank AND the hosting platform replaces the app's own
# deploy directory wholesale on every redeploy (Hostinger's Web App builds do exactly this — each
# deploy is a brand-new directory under hbuilds/versions/<uuid>/, so the default
# apps/api/uploads/ path gets wiped every time). Point this at an ABSOLUTE path outside that
# versioned tree, e.g. a sibling directory under the domain's home
# (/home/<account>/domains/<subdomain>/persistent-uploads) — it's created automatically on first
# upload if missing. Omit this line entirely for local dev (an empty `UPLOADS_DIR=` is read as ""
# rather than unset, which breaks the local-disk fallback's default path) — the default
# (apps/api/uploads/) is fine.

# Maps
MAPS_API_KEY=

# Anti-spam (optional)
RECAPTCHA_SECRET_KEY=

# WhatsApp business number (international format, no +/spaces)
WHATSAPP_NUMBER=919324702438

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Auth
PASSWORD_RESET_TOKEN_TTL_MIN=60

# Seed script — only needed once, for the initial Super Admin account. Set a real password here
# (don't leave it blank in production, since an auto-generated one is only ever printed to the
# console log, which you may not be watching on a live server) and remove it from `.env` again
# after the first successful `npm run seed` run.
SEED_SUPER_ADMIN_EMAIL=districtonerealty@gmail.com
SEED_SUPER_ADMIN_PASSWORD=<set-a-real-strong-password-then-remove-this-line-after-seeding>
