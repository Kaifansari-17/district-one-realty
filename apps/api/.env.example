# ---------------------------------------------------------------------------
# District One Realty API - environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MySQL (Prisma connection string)
DATABASE_URL="mysql://root:password@127.0.0.1:3306/district_one_realty"

# JWT / Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
# Refresh tokens are opaque random strings stored hashed in the DB, not JWTs — no secret needed.
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_DOMAIN=.districtonerealty.com

# Frontend origins allowed by CORS (production)
PUBLIC_WEB_URL=https://www.districtonerealty.com
ADMIN_WEB_URL=https://admin.districtonerealty.com

# Frontend origins allowed by CORS (development only, used when NODE_ENV=development)
DEV_PUBLIC_WEB_URL=http://localhost:5173
DEV_ADMIN_WEB_URL=http://localhost:5174

# Cloudinary — leave all three blank to automatically fall back to local disk storage under
# apps/api/uploads/ (served at /uploads), which needs no external account. Fill in all three to
# switch to Cloudinary instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Only used by the local disk storage fallback above, to build absolute file URLs. Defaults to
# http://localhost:<PORT> in development; set explicitly in production (e.g.
# https://api.districtonerealty.com) if not using Cloudinary there.
API_PUBLIC_URL=

# Maps
MAPS_API_KEY=

# Anti-spam (optional)
RECAPTCHA_SECRET_KEY=

# WhatsApp business number (international format, no +/spaces)
WHATSAPP_NUMBER=919324702438

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Auth
PASSWORD_RESET_TOKEN_TTL_MIN=60

# Seed script (optional — omit password to auto-generate and print it once)
SEED_SUPER_ADMIN_EMAIL=districtonerealty@gmail.com
SEED_SUPER_ADMIN_PASSWORD=
